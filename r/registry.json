{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "9am",
  "homepage": "https://github.com/ilovehugetits/9am-ui",
  "items": [
    {
      "name": "theme",
      "type": "registry:file",
      "title": "9AM Theme",
      "description": "The 9AM design language: OKLCH token set for both palettes, the primary-50..950 ramp, radius scale, class-driven dark variant and the NUI base rules. Locked — `9am-ui check` fails on drift. Pair with @9am/fonts.",
      "dependencies": [
        "tailwindcss@^4.3.3",
        "tw-animate-css@^1.4.0"
      ],
      "files": [
        {
          "path": "registry/theme/9am-theme.css",
          "type": "registry:file",
          "target": "src/styles/9am-theme.css"
        }
      ]
    },
    {
      "name": "fonts",
      "type": "registry:file",
      "title": "9AM Fonts (embedded)",
      "description": "Poppins + Phudu embedded as base64, so the theme installs with nothing else to fetch. Apps with several html entry points (DUI pages especially) should use `bunx 9am-ui fonts` for the linked variant instead.",
      "files": [
        {
          "path": "registry/theme/9am-fonts.css",
          "type": "registry:file",
          "target": "src/styles/9am-fonts.css"
        }
      ]
    },
    {
      "name": "tools",
      "type": "registry:file",
      "title": "Drift Check CLI",
      "description": "Zero-dependency `check` / `doctor` script, installed to scripts/9am-ui.mjs. Reuses the registry token already in components.json, so there is no second set of credentials to configure. Wire `check` into CI.",
      "files": [
        {
          "path": "registry/tools/9am-ui.mjs",
          "type": "registry:file",
          "target": "~/scripts/9am-ui.mjs"
        }
      ]
    },
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "cn()",
      "description": "The cn() class merger every component uses.",
      "dependencies": [
        "clsx@^2.1.1",
        "tailwind-merge@^3.6.0"
      ],
      "files": [
        {
          "path": "registry/lib/utils.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "smooth-scroll",
      "type": "registry:lib",
      "title": "Smooth Scroll (CEF fix)",
      "description": "Global wheel-scroll handler. Repairs scrolling in FiveM CEF (Chromium 103 will not wheel-scroll clip-path'd containers) and gives every scroller the same eased feel.",
      "files": [
        {
          "path": "registry/lib/smooth-scroll.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "nui",
      "type": "registry:file",
      "title": "NUI Bridge",
      "description": "fetchNui, useNuiEvent, debugData, isEnvBrowser and the per-script nui.config.ts.",
      "files": [
        {
          "path": "registry/nui/nui.config.ts",
          "type": "registry:file",
          "target": "src/nui.config.ts"
        },
        {
          "path": "registry/nui/misc.ts",
          "type": "registry:file",
          "target": "src/utils/misc.ts"
        },
        {
          "path": "registry/nui/fetchNui.ts",
          "type": "registry:file",
          "target": "src/utils/fetchNui.ts"
        },
        {
          "path": "registry/nui/debugData.ts",
          "type": "registry:file",
          "target": "src/utils/debugData.ts"
        },
        {
          "path": "registry/nui/useNuiEvent.ts",
          "type": "registry:hook"
        },
        {
          "path": "registry/nui/vite-env.d.ts",
          "type": "registry:file",
          "target": "src/vite-env.d.ts"
        }
      ]
    },
    {
      "name": "use-theme",
