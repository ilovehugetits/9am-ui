{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "@/components/ui/*": ["../../registry/ui/*", "../../registry/icons/*"],
      "@/components/pages/*": ["../../registry/dashboard-scaffold/*"],
      "@/lib/utils": ["../../registry/lib/utils.ts"],
      "@/lib/smooth-scroll": ["../../registry/lib/smooth-scroll.ts"],
      "@/hooks/*": ["../../registry/nui/*"],
      "@/utils/*": ["../../registry/nui/*"],
      "@/providers/*": ["../../registry/nui/*"],
      "@/i18n": ["../../registry/i18n/index.ts"],
      "@/nui.config": ["../../registry/nui/nui.config.ts"],
      "@/*": ["./*"],
      "collections/*": ["./.source/*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "../../registry/scaffold"]
}
