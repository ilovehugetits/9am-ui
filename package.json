{
  "name": "9am-ui",
  "type": "module",
  "version": "1.1.0",
  "workspaces": ["apps/docs"],
  "description": "The shared design language, NUI plumbing and FiveM CEF workarounds behind every 9AM Studios script — an open shadcn registry.",
  "license": "MIT",
  "homepage": "https://github.com/ilovehugetits/9am-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ilovehugetits/9am-ui.git"
  },
  "bugs": {
    "url": "https://github.com/ilovehugetits/9am-ui/issues"
  },
  "keywords": [
    "fivem",
    "nui",
    "cef",
    "shadcn",
    "shadcn-registry",
    "react",
    "tailwindcss",
    "ui"
  ],
  "bin": {
    "9am-ui": "dist/9am-ui.mjs"
  },
  "files": [
    "cli",
    "dist",
    "r",
    "registry",
    "scripts"
  ],
  "scripts": {
    "fonts": "bun scripts/build-fonts.ts",
    "registry:gen": "bun scripts/build-registry.ts",
    "registry:build": "bunx --bun shadcn@latest build --output r",
    "cli:build": "bun build cli/index.ts --target=node --format=esm --outfile=dist/9am-ui.mjs --banner \"#!/usr/bin/env node\"",
    "build": "bun run fonts && bun run registry:gen && bun run registry:build && bun run cli:build",
    "prepublishOnly": "bun run cli:build",
    "check": "bun cli/index.ts check",
    "doctor": "bun cli/index.ts doctor",
    "typecheck": "tsc --noEmit",
    "docs": "bun run --cwd apps/docs dev",
    "docs:build": "bun run --cwd apps/docs build",
    "preview": "vite --config apps/preview/vite.config.ts",
    "preview:build": "vite build --config apps/preview/vite.config.ts"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.21",
    "@radix-ui/react-label": "^2.1.13",
    "@radix-ui/react-popover": "^1.1.21",
    "@radix-ui/react-select": "^2.3.5",
    "@radix-ui/react-slot": "^1.3.1",
    "@radix-ui/react-switch": "^1.3.5",
    "@radix-ui/react-tabs": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.14",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "motion": "^12.42.2",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "recharts": "^3.10.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
